NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://backend:backend@localhost:5432/backend_db?schema=public
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change-me-in-production-internal-service-token
AI_TIMEOUT_MS=60000
# openai, bedrock ou fake. Bedrock fala o mesmo protocolo e dispensa chave: o
# token e assinado a cada requisicao a partir das credenciais AWS do ambiente.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=openai.gpt-oss-120b
NEXT_PUBLIC_API_URL=http://localhost:3001

JWT_SECRET=change-me-in-production-this-must-be-a-long-random-string
JWT_EXPIRES_IN=7d

BCRYPT_ROUNDS=12

THROTTLE_LIMIT=30
THROTTLE_WINDOW_MS=60000

SEED_ADMIN_EMAIL=admin@backend.com.br
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NAME=Administrador
# O colaborador existe para exercitar o isolamento entre pessoas da mesma
# empresa e para demonstrar a visao do trabalhador, nao so a do gestor.
SEED_WORKER_EMAIL=colaborador@backend.com.br
SEED_WORKER_PASSWORD=change-me-strong-password
SEED_WORKER_NAME=Colaborador
SEED_COMPANY_NAME=Hackathon Organization
SEED_COMPANY_SLUG=hackathon

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ESelfReportSituation {
  SURPLUS
  BREAK_EVEN
  SLIGHT_SHORTFALL
  SEVERE_SHORTFALL

  @@map("self_report_situation")
}

enum ECoopsStage {
  CONSCIENTIZAR
  OBSERVAR
  ORGANIZAR
  PREPARAR
  SUSTENTAR

  @@map("coops_stage")
}

enum EUserRole {
  ADMIN
  EDITOR
  VIEWER
  USER

  @@map("user_role")
}

enum ESavingsGoalKind {
  MONTHLY
  ENDURING

  @@map("savings_goal_kind")
}

enum ESavingsGoalStatus {
  ACTIVE
  MET
  ENDED

  @@map("savings_goal_status")
}

enum ESavingsGoalUnmetReason {
  UNEXPECTED_EXPENSE
  INCOME_DROP
  CHANGED_PRIORITY
  PREFER_NOT_SAY
  OTHER

  @@map("savings_goal_unmet_reason")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            EUserRole @default(USER)
  avatarUrl       String?   @map("avatar_url")
  active          Boolean   @default(true)
  tokenValidAfter DateTime? @map("token_valid_after")
  companyId       String    @map("company_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  company Company @relation(fields: [companyId], references: [id])
  auditEvents AuditEvent[] @relation("AuditActor")
  selfReports SelfReport[]
  dailyEntries DailyEntry[]
  savingsGoals SavingsGoal[]

  @@index([role, active])
  @@index([companyId])
  @@map("users")
}

model Company {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  /// Fuso da unidade. Cuiaba e Belem nao coincidem, e a janela e local.
  journeyZone String  @default("America/Cuiaba") @map("journey_zone")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]
  auditEvents AuditEvent[]
  selfReports SelfReport[]
  dailyEntries DailyEntry[]
  savingsGoals SavingsGoal[]
  journeyShifts CompanyJourneyShift[]
  journeyExceptions CompanyJourneyException[]

  @@index([active])
  @@map("companies")
}

/// Uma faixa de expediente da unidade, em minutos desde a meia-noite local.
/// Turno que atravessa a meia-noite sao duas linhas em dias diferentes.
model CompanyJourneyShift {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  /// 0 = domingo ... 6 = sabado.
  weekday   Int
  /// Minutos desde a meia-noite local, de 0 a 1439.
  opensAt   Int    @map("opens_at")
  /// Minutos desde a meia-noite local, de 1 a 1440 (1440 e a meia-noite seguinte).
  closesAt  Int    @map("closes_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, weekday, opensAt])
  @@index([companyId])
  @@map("company_journey_shifts")
}

/// Um dia em que a unidade nao trabalha: feriado, ponto facultativo, recesso
/// ou parada de fabrica. A empresa mantem a lista, porque feriado municipal
/// nao sai de biblioteca nenhuma com confianca.
model CompanyJourneyException {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  /// A data no calendario da unidade, sem hora.
  date      DateTime @db.Date
  reason    String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
  @@map("company_journey_exceptions")
}

model AuditEvent {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  requestId    String?  @map("request_id")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@map("audit_events")
}

model SelfReport {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  companyId      String               @map("company_id")
  referenceMonth DateTime             @map("reference_month") @db.Date
  situation      ESelfReportSituation
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceMonth])
  @@index([companyId, referenceMonth])
  @@map("self_reports")
}

model DailyEntry {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  companyId String    @map("company_id")
  entryDate      DateTime @map("entry_date") @db.Date
  mood           Int
  moodDeclared   Boolean  @default(true) @map("mood_declared")
  contentPieceId String?  @map("content_piece_id")
  answer         String?
  comprehended   Boolean?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contentPiece ContentPiece? @relation(fields: [contentPieceId], references: [id])

  @@unique([userId, entryDate])
  @@index([companyId, entryDate])
  @@map("daily_entries")
}

/// Peça curta do método COOPS do programa Cooperação na Ponta do Lápis.
/// As etapas são a trilha: a pessoa caminha por elas na ordem.
model ContentPiece {
  id           String      @id @default(uuid())
  stage        ECoopsStage
  orderInStage Int         @map("order_in_stage")
  title        String
  body         String
  prompt       String
  options      Json
  sourceUrl    String      @map("source_url")
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  dailyEntries DailyEntry[]

  @@unique([stage, orderInStage])
  @@map("content_pieces")
}

/// Meta de guarda pessoal, com valor-alvo autodeclarado em centavos (#71,
/// que reverteu conscientemente a regra "sem cifra" da #63). O valor e uma
/// intencao que a pessoa define: nunca e verificado contra saldo, porque o
/// produto nao acessa conta, extrato nem transacao. O cumprimento mensal
/// continua vindo da declaracao do mes (SelfReport). Recurso estritamente
/// pessoal — valor, meta e motivo nunca sao agregados nem expostos ao gestor.
model SavingsGoal {
  id           String                   @id @default(uuid())
  userId       String                   @map("user_id")
  companyId    String                   @map("company_id")
  kind         ESavingsGoalKind
  /// Valor-alvo autodeclarado, em centavos (inteiro, evita float). No modo
  /// duradouro, dividido pelos meses dá o alvo mensal. É intenção da pessoa,
  /// nunca verificado contra saldo. Privado — nunca vai ao painel do gestor.
  targetAmountCents Int                 @map("target_amount_cents")
  /// Só para ENDURING: por quantos meses manter a guarda. MONTHLY não usa.
  targetMonths Int?                     @map("target_months")
  /// Primeiro dia do mês em que a meta começa (UTC), do relógio do servidor.
  startMonth   DateTime                 @map("start_month") @db.Date
  status       ESavingsGoalStatus       @default(ACTIVE)
  /// Preenchido só quando a pessoa encerra sem cumprir e escolhe dizer. Opção
  /// fechada, nunca texto livre. Privado por definição.
  unmetReason  ESavingsGoalUnmetReason? @map("unmet_reason")
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  deletedAt    DateTime?                @map("deleted_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, companyId])
  @@map("savings_goals")
}
